# Copy to .env and fill in. Never commit your .env file.

# --- Required ---------------------------------------------------------------
# Coinbase Developer Platform API key: https://portal.cdp.coinbase.com/
CDP_API_KEY_NAME=organizations/.../apiKeys/...
CDP_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Moralis Web3 Data API key: https://admin.moralis.com/
MORALIS_API_KEY=

# --- Wallet -----------------------------------------------------------------
# Network for a newly created wallet: base-sepolia (testnet) or base-mainnet
NETWORK_ID=base-sepolia
# Reuse an existing wallet. Leave empty to auto-load the wallet in WALLET_SEED_FILE,
# or to create a new one on first run.
CDP_WALLET_ID=
WALLET_SEED_FILE=wallet_seed.json

# --- Models -----------------------------------------------------------------
OPENAI_MODEL=gpt-4o
OPENAI_GUIDE_MODEL=gpt-4o-mini

# --- Optional features ------------------------------------------------------
# Adds the DALL-E generate_art tool (billed per image)
ENABLE_ART_GENERATION=false
# Adds X/Twitter tools when all four are set: https://developer.x.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
